6\u0438 \u041c\u0430\u0442\u0438\u0458\u0438\u043d\u0435 \u043b\u0438\u0432\u0430\u0434\u0435<\/p><p>\u041f\u0440\u0438\u0458\u0435\u0432\u043e\u0440, \u043f\u0443\u0442 \u043a\u0430 \u041a\u0430\u043c\u0435\u043d\u0438\u0446\u0438.<\/p><p>\u0423 \u043d\u0430\u0432\u0435\u0434\u0435\u043d\u0438\u043c \u0438 \u0443 \u043e\u043a\u043e\u043b\u043d\u0438\u043c \u0443\u043b\u0438\u0446\u0430\u043c\u0430, \u0458\u0435 \u043c\u043e\u0433\u0443\u045b\u0435 \u0440\u0435\u0434\u0443\u043a\u043e\u0432\u0430\u043d\u043e \u0441\u043d\u0430\u0431\u0434\u0435\u0432\u0430\u045a\u0435 \u0432\u043e\u0434\u043e\u043c \u0443 \u0442\u043e\u043a\u0443 \u0440\u0430\u0434\u043e\u0432\u0430.<br \/>\u0423 \u043d\u0430\u0458\u043a\u0440\u0430\u045b\u0435\u043c \u0440\u043e\u043a\u0443, \u043d\u0430\u0448\u0435 \u0435\u043a\u0438\u043f\u0435 \u0442\u0440\u0443\u0434\u0438\u045b\u0435 \u0441\u0435 \u0434\u0430 \u043e\u0442\u043a\u043b\u043e\u043d\u0435 \u043a\u0432\u0430\u0440 \u043d\u0430 \u043c\u0440\u0435\u0436\u0438.<br \/>\u0418\u0437\u0432\u0438\u045a\u0430\u0432\u0430\u043c\u043e \u0441\u0435 \u043f\u043e\u0442\u0440\u043e\u0448\u0430\u0447\u0438\u043c\u0430 \u0437\u0431\u043e\u0433 \u043c\u043e\u0433\u0443\u045b\u0438\u0445 \u043d\u0435\u0443\u0433\u043e\u0434\u043d\u043e\u0441\u0442\u0438 \u0443\u0441\u043b\u0435\u0434 \u0440\u0435\u0434\u0443\u043a\u043e\u0432\u0430\u043d\u043e\u0433 \u0441\u043d\u0430\u0431\u0434\u0435\u0432\u0430\u045a\u0430 \u0432\u043e\u0434\u043e\u043c.<\/p><p>\u041c\u043e\u043b\u0438\u043c\u043e \u0443\u0447\u0435\u0441\u043d\u0438\u043a\u0435 \u0443 \u0441\u0430\u043e\u0431\u0440\u0430\u045b\u0430\u0458\u0443, \u0434\u0430 \u0438\u0441\u043f\u043e\u0448\u0442\u0443\u0458\u0443 \u043f\u0440\u0438\u0432\u0440\u0435\u043c\u0435\u043d\u0443 \u0432\u0435\u0440\u0442\u0438\u043a\u0430\u043b\u043d\u0443 \u0441\u0438\u0433\u043d\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0458\u0443 \u0443 \u0442\u043e\u043a\u0443 \u0440\u0430\u0434\u043e\u0432\u0430.<\/p><p>\u0423 \u043e\u0441\u0442\u0430\u043b\u0438\u043c \u0434\u0435\u043b\u043e\u0432\u0438\u043c\u0430 \u043d\u0430\u0448\u0435\u0433 \u0432\u043e\u0434\u043e\u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u0441\u043d\u0430\u0434\u0431\u0435\u0432\u0430\u045a\u0435 \u0432\u043e\u0434\u043e\u043c \u0458\u0435 \u0440\u0435\u0434\u043e\u0432\u043d\u043e.<\/p><p>\u0417\u0430 \u043f\u0440\u0438\u0458\u0430\u0432\u0443 \u043a\u0432\u0430\u0440\u043e\u0432\u0430 \u0438 \u0441\u0432\u0435 \u0434\u043e\u0434\u0430\u0442\u043d\u0435 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0458\u0435 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0438-5529-009 \u0438 5561-571 \u043e\u0434 7 \u0434\u043e 15 \u0447\u0430\u0441\u043e\u0432\u0430,<\/p><p>5562-524 \u0434\u0435\u0436\u0443\u0440\u043d\u0438 \u0442\u0435\u043b\u0435\u0444\u043e\u043d 24 \u0441\u0430\u0442\u0438 \u0434\u043d\u0435\u0432\u043d\u043e.<\/p>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t","protected":false}},{"date":"2026-06-02T16:33:25","link":"https:\/\/vodovodca.rs\/%d0%be%d0%b1%d0%b0%d0%b2%d0%b5%d1%88%d1%82%d0%b5%d1%9a%d0%b5-02-06-2026-%d0%b3%d0%be%d0%b4%d0%b8%d0%bd%d0%b5\/","title":{"rendered":"\u041e\u0431\u0430\u0432\u0435\u0448\u0442\u0435\u045a\u0435 &#8211; 02.06.2026. \u0433\u043e\u0434\u0438\u043d\u0435"},"content":{"rendered":"<figure class=\"wp-block-image size-large\"><img loading=\"lazy\" decoding=\"async\" width=\"724\" height=\"1024\" src=\"https:\/\/vodovodca.rs\/wp-content\/uploads\/2026\/06\/obavestenje_kontrola_ispravnosti_02jun2026-724x1024.jpg\" alt=\"\" class=\"wp-image-5097\" srcset=\"https:\/\/vodovodca.rs\/wp-content\/uploads\/2026\/06\/obavestenje_kontrola_ispravnosti_02jun2026-724x1024.jpg 724w, https:\/\/vodovodca.rs\/wp-content\/uploads\/2026\/06\/obavestenje_kontrola_ispravnosti_02jun2026-212x300.jpg 212w, https:\/\/vodovodca.rs\/wp-content\/uploads\/2026\/06\/obavestenje_kontrola_ispravnosti_02jun2026-768x1087.jpg 768w, https:\/\/vodovodca.rs\